{
  "jira": {
    "base_url": "https://your-tenant.atlassian.net",
    "email": "integration@example.com",
    "token_ref": "env:JIRA_API_TOKEN",
    "jql": "project = NAC AND issuetype = \"Network Access\" AND status = \"To Do\" ORDER BY created ASC",
    "limit": 50,
    "scan_limit": 1000
  },
  "fireflow": {
    "legacy_rt_enabled": false,
    "legacy_rt_read_enabled": true,
    "base_url": "https://asms.example.com",
    "username": "jira_fireflow_service",
    "password_ref": "env:ASMS_API_PASSWORD",
    "tls_certificate_sha256": "REPLACE_WITH_VERIFIED_64_HEX_SHA256",
    "template": "Basic Change Traffic Request",
    "devices": [
      "edge-fw-01"
    ],
    "allowed_templates": [
      "Basic Change Traffic Request"
    ],
    "allowed_devices": [
      "edge-fw-01"
    ],
    "allowed_fields": [
      "devices",
      "subject",
      "Change Request Description",
      "Requestor"
    ],
    "request_timeout": 30
  },
  "mapping": {
    "structured": {
      "field": "customfield_10000"
    }
  },
  "apply": false,
  "max_per_pass": 1,
  "state": "/var/lib/algosec-jira-bus/jira-sync.json",
  "journal": "/var/lib/algosec-jira-bus",
  "mirror": {
    "comment": "AlgoSec FireFlow: заявка %(id)s тепер у статусі %(status)s.",
    "transitions": {
      "open": "Plan",
      "plan": "Plan",
      "approve": "Approve",
      "create work order": "Implement",
      "implement": "Implement",
      "validate": "Validate",
      "reconcile": "Match",
      "pending match": "Match",
      "match": "Match",
      "rejected": "Rejected",
      "cancelled": "Cancelled",
      "new": "To Do",
      "operational review": "Approve",
      "user accept": "Validate",
      "user disapproved": "Validate",
      "notify requestors": "Approve",
      "pending response": "Approve",
      "check": "Approve",
      "implementation plan": "Implement",
      "user confirmed": "Validate",
      "requestor response": "Validate",
      "reconciled": "Match",
      "already works": "Done",
      "deleted": "Cancelled"
    },
    "result_fields": {
      "id": "customfield_10001",
      "status": "customfield_10002",
      "owner": "customfield_10003"
    },
    "verify_resolved_children": true,
    "outcome_rules": [
      {
        "status": "resolved",
        "field": "Completion verified",
        "equals": "yes",
        "transition": "Done"
      },
      {
        "status": "resolved",
        "field": "Completion outcome",
        "equals": "already works",
        "transition": "Done"
      },
      {
        "status": "approved",
        "field": "Workflow",
        "equals": "Basic",
        "transition": "Approve"
      }
    ],
    "observed_fields": [
      "Risk Level",
      "Risks Number",
      "Validation Result Details",
      "Initial Plan status",
      "Workflow"
    ]
  },
  "intake": {
    "mode": "todo"
  },
  "jira_to_fireflow": {
    "enabled": false,
    "comments": true,
    "status_map": {}
  }
}
